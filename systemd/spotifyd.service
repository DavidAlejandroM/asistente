[Unit]
Description=spotifyd (dispositivo Spotify Connect)
After=network-online.target sound.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/spotifyd --no-daemon --config-path /home/pi/asistente/systemd/spotifyd.conf
Restart=always
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
